---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFormatter = new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "long", year: "numeric" });
---

<Layout
  title="Blog — AzoMedIA"
  description="Conseils pratiques sur l'IA, l'automatisation et le numérique pour les entreprises béninoises et africaines."
>
  <section class="pt-40 pb-24 bg-navy-gradient text-white">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <p class="text-accent font-semibold text-sm uppercase tracking-widest mb-3">Blog</p>
      <h1 class="font-heading text-4xl md:text-5xl font-bold mb-4">Ressources & réflexions</h1>
      <p class="text-white/75 max-w-xl mx-auto">
        Des conseils concrets sur l'IA, l'automatisation et le numérique, pensés pour les réalités des entreprises
        d'Afrique francophone.
      </p>
    </div>
  </section>

  <section class="py-20 bg-surface">
    <div class="max-w-6xl mx-auto px-6 lg:px-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="group block rounded-2xl overflow-hidden bg-white border border-navy/5 shadow-sm hover:shadow-lg transition-shadow">
            <div class="aspect-[16/9] overflow-hidden">
              <Image
                src={post.data.image}
                alt={post.data.title}
                width={600}
                height={340}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            <div class="p-6">
              <p class="text-xs text-navy/50 mb-2">{dateFormatter.format(post.data.date)}</p>
              <h2 class="font-heading text-lg font-semibold text-navy mb-2 leading-snug">{post.data.title}</h2>
              <p class="text-sm text-navy/70 leading-relaxed line-clamp-3">{post.data.excerpt}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
