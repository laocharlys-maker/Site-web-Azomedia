---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "long", year: "numeric" });
---

<Layout title={`${post.data.title} — Blog AzoMedIA`} description={post.data.excerpt}>
  <article>
    <header class="pt-40 pb-16 bg-navy-gradient text-white">
      <div class="max-w-3xl mx-auto px-6 lg:px-8">
        <a href="/blog" class="text-accent text-sm font-semibold mb-6 inline-block">&larr; Retour au blog</a>

        <p class="text-xs text-white/60 mb-3">
          {dateFormatter.format(post.data.date)} · {post.data.author}
        </p>
        <h1 class="font-heading text-3xl md:text-4xl font-bold mb-2 leading-tight">{post.data.title}</h1>
      </div>
    </header>

    <div class="bg-surface py-16">
      <div class="max-w-3xl mx-auto px-6 lg:px-8">
        <div class="rounded-2xl overflow-hidden mb-10 -mt-24 shadow-lg">
          <Image src={post.data.image} alt={post.data.title} width={900} height={506} class="w-full h-auto" />
        </div>

        <div class="flex flex-wrap gap-2 mb-10">
          {
            post.data.tags.map((tag) => (
              <span class="text-xs font-medium text-accent bg-accent/10 px-3 py-1 rounded-full">{tag}</span>
            ))
          }
        </div>

        <div class="prose prose-navy max-w-none prose-headings:font-heading prose-a:text-accent">
          <Content />
        </div>
      </div>
    </div>
  </article>
</Layout>
