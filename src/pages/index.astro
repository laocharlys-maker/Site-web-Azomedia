---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import ServiceCard from "../components/ServiceCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import CTASection from "../components/CTASection.astro";
import {
  site,
  services,
  painPoints,
  pillars,
  sectors,
  testimonials,
  realisations,
  founder,
  team,
  whyUsImage,
} from "../data/site";
---

<Layout
  title="AzoMedIA — Agence de solutions numériques intelligentes à Cotonou, Bénin"
  description="AzoMedIA conçoit des solutions numériques sur mesure pour les entreprises béninoises et africaines : audit IA, sites web, agents IA, automatisation, chatbot et formations."
>
  <Hero />

  <!-- Le problème -->
  <section class="py-24 bg-surface">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="max-w-2xl mb-14">
        <h2 class="reveal font-heading text-3xl md:text-4xl font-bold text-navy mb-4">
          Chaque jour sans solution numérique a un coût
        </h2>
        <p class="reveal text-navy/70">
          Ce ne sont pas juste des désagréments : ce sont des opportunités concrètes qui échappent à votre
          entreprise.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {
          painPoints.map((point) => (
            <div class="reveal">
              <div class="w-10 h-10 rounded-full bg-accent/10 text-accent flex items-center justify-center font-heading font-bold mb-4">
                !
              </div>
              <h3 class="font-heading text-lg font-semibold text-navy mb-2">{point.title}</h3>
              <p class="text-sm text-navy/70 leading-relaxed">{point.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Nos services -->
  <section id="services" class="py-24 bg-white scroll-mt-20">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="max-w-2xl mb-14">
        <p class="reveal text-accent font-semibold text-sm uppercase tracking-widest mb-3">Nos services</p>
        <h2 class="reveal font-heading text-3xl md:text-4xl font-bold text-navy mb-4">
          Des solutions concrètes, du diagnostic au déploiement
        </h2>
        <p class="reveal text-navy/70">
          Chaque service peut être pris isolément ou combiné dans un accompagnement complet.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          services.map((service, i) => (
            <ServiceCard {...service} featured={i === 0} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Pourquoi AzoMedIA -->
  <section id="pourquoi-nous" class="py-24 bg-surface scroll-mt-20">
    <div class="max-w-6xl mx-auto px-6 lg:px-8 grid lg:grid-cols-2 gap-12 items-center">
      <div class="reveal order-2 lg:order-1 rounded-2xl overflow-hidden shadow-lg">
        <Image
          src={whyUsImage}
          alt="Une relation de confiance entre AzoMedIA et ses clients"
          width={600}
          height={600}
          class="w-full h-full object-cover"
        />
      </div>

      <div class="order-1 lg:order-2">
        <div class="max-w-2xl mb-10">
          <p class="reveal text-accent font-semibold text-sm uppercase tracking-widest mb-3">Pourquoi AzoMedIA</p>
          <h2 class="reveal font-heading text-3xl md:text-4xl font-bold text-navy mb-4">
            Une approche pensée pour les réalités du terrain
          </h2>
        </div>

        <div class="grid sm:grid-cols-2 gap-8">
          {
            pillars.map((pillar) => (
              <div class="reveal">
                <div class="w-10 h-10 rounded-xl bg-navy text-white flex items-center justify-center mb-4">
                  <Icon name="check" class="w-5 h-5" />
                </div>
                <h3 class="font-heading text-base font-semibold text-navy mb-2">{pillar.title}</h3>
                <p class="text-sm text-navy/70 leading-relaxed">{pillar.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- À propos -->
  <section id="a-propos" class="py-24 bg-surface scroll-mt-20">
    <div class="max-w-5xl mx-auto px-6 lg:px-8 grid md:grid-cols-[auto_1fr] gap-10 items-center">
      <div class="reveal shrink-0 mx-auto md:mx-0">
        <Image
          src={founder.photo}
          alt={founder.name}
          width={200}
          height={200}
          class="w-40 h-40 md:w-48 md:h-48 rounded-full object-cover border-4 border-white shadow-lg"
        />
      </div>
      <div class="reveal text-center md:text-left">
        <p class="text-accent font-semibold text-sm uppercase tracking-widest mb-3">À propos</p>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-navy mb-1">{founder.name}</h2>
        <p class="text-accent font-semibold mb-4">{founder.role}</p>
        {founder.bio.map((paragraph) => <p class="text-navy/70 leading-relaxed mb-3">{paragraph}</p>)}
      </div>
    </div>

    <div class="reveal max-w-5xl mx-auto px-6 lg:px-8 mt-16">
      <div class="rounded-2xl overflow-hidden shadow-lg">
        <Image
          src={team.photo}
          alt={team.caption}
          width={1000}
          height={560}
          class="w-full h-auto max-h-[420px] object-cover object-top"
        />
      </div>
      <p class="text-center text-navy/60 text-sm mt-4 italic">{team.caption}</p>
    </div>
  </section>

  <!-- Réalisations -->
  <section id="realisations" class="py-24 bg-white scroll-mt-20">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="max-w-2xl mb-14">
        <p class="reveal text-accent font-semibold text-sm uppercase tracking-widest mb-3">Réalisations</p>
        <h2 class="reveal font-heading text-3xl md:text-4xl font-bold text-navy mb-4">Ils nous font confiance</h2>
        <p class="reveal text-navy/70">
          Quelques plateformes conçues et déployées récemment pour nos clients.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          realisations.map((r) => (
            <div class="reveal rounded-2xl border border-navy/5 bg-surface overflow-hidden flex flex-col shadow-sm">
              {r.image ? (
                <div class="aspect-[16/10] overflow-hidden border-b border-navy/5">
                  <Image
                    src={r.image}
                    alt={r.name}
                    width={480}
                    height={300}
                    class="w-full h-full object-cover object-top"
                  />
                </div>
              ) : (
                <div class="aspect-[16/10] bg-navy-gradient flex items-center justify-center border-b border-navy/5">
                  <div class="w-14 h-14 rounded-full bg-white/10 text-white flex items-center justify-center">
                    <Icon name={r.icon ?? "check"} class="w-7 h-7" />
                  </div>
                </div>
              )}
              <div class="p-6 flex flex-col flex-1">
                <p class="text-xs font-semibold text-accent uppercase tracking-wide mb-1">{r.category}</p>
                <p class="font-heading font-semibold text-navy mb-2">{r.name}</p>
                <p class="text-sm text-navy/70 leading-relaxed flex-1">{r.description}</p>
                {r.placeholder && <p class="mt-3 text-xs text-navy/40 italic">Capture d'écran à venir</p>}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Secteurs ciblés -->
  <section id="secteurs" class="py-24 bg-surface scroll-mt-20">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="max-w-2xl mb-14">
        <p class="reveal text-accent font-semibold text-sm uppercase tracking-widest mb-3">Secteurs ciblés</p>
        <h2 class="reveal font-heading text-3xl md:text-4xl font-bold text-navy mb-4">
          Une expertise qui s'adapte à votre secteur
        </h2>
      </div>

      <div class="flex flex-wrap gap-3">
        {
          sectors.map((sector) => (
            <span class="reveal px-5 py-2.5 rounded-full bg-white border border-navy/10 text-sm font-medium text-navy">
              {sector}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Témoignages -->
  <section class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="max-w-2xl mb-14">
        <p class="reveal text-accent font-semibold text-sm uppercase tracking-widest mb-3">Témoignages</p>
        <h2 class="reveal font-heading text-3xl md:text-4xl font-bold text-navy mb-4">Ce qu'ils en disent</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {testimonials.map((t) => <TestimonialCard {...t} />)}
      </div>
    </div>
  </section>

  <CTASection />

  <!-- Contact -->
  <section id="contact" class="py-24 bg-surface scroll-mt-20">
    <div class="max-w-5xl mx-auto px-6 lg:px-8 grid lg:grid-cols-2 gap-14">
      <div>
        <p class="reveal text-accent font-semibold text-sm uppercase tracking-widest mb-3">Contact</p>
        <h2 class="reveal font-heading text-3xl md:text-4xl font-bold text-navy mb-4">Parlons de votre projet</h2>
        <p class="reveal text-navy/70 mb-8">
          Décrivez-nous votre besoin, on revient vers vous rapidement pour caler un premier échange.
        </p>

        <ul class="reveal space-y-4 text-sm">
          <li class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-full bg-accent/10 text-accent flex items-center justify-center">
              <Icon name="phone" class="w-4 h-4" />
            </span>
            <a href={`tel:${site.phone.replace(/\s/g, "")}`} class="text-navy font-medium">{site.phone}</a>
          </li>
          <li class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-full bg-accent/10 text-accent flex items-center justify-center">
              <Icon name="mail" class="w-4 h-4" />
            </span>
            <a href={`mailto:${site.email}`} class="text-navy font-medium">{site.email}</a>
          </li>
          <li class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-full bg-accent/10 text-accent flex items-center justify-center">
              <Icon name="pin" class="w-4 h-4" />
            </span>
            <span class="text-navy font-medium">{site.address}</span>
          </li>
        </ul>
      </div>

      <form id="contact-form" class="reveal bg-white rounded-2xl border border-navy/5 shadow-sm p-8 space-y-4">
        <input type="hidden" name="access_key" value={site.web3formsAccessKey} />
        <input type="hidden" name="subject" value="Nouveau message — formulaire de contact AzoMedIA" />
        <input type="hidden" name="from_name" value="Formulaire Contact — site AzoMedIA" />

        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="name" class="block text-xs font-semibold text-navy/70 mb-1.5">Nom *</label>
            <input
              id="name"
              name="Nom"
              type="text"
              required
              class="w-full rounded-lg border border-navy/10 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-accent/50"
            />
          </div>
          <div>
            <label for="company" class="block text-xs font-semibold text-navy/70 mb-1.5">Entreprise</label>
            <input
              id="company"
              name="Entreprise"
              type="text"
              class="w-full rounded-lg border border-navy/10 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-accent/50"
            />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="phone" class="block text-xs font-semibold text-navy/70 mb-1.5">Téléphone / WhatsApp *</label>
            <input
              id="phone"
              name="Téléphone"
              type="tel"
              required
              class="w-full rounded-lg border border-navy/10 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-accent/50"
            />
          </div>
          <div>
            <label for="sector" class="block text-xs font-semibold text-navy/70 mb-1.5">Secteur</label>
            <select
              id="sector"
              name="Secteur"
              class="w-full rounded-lg border border-navy/10 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-accent/50"
            >
              <option value="">Sélectionner...</option>
              {sectors.map((sector) => <option value={sector}>{sector}</option>)}
              <option value="Autre">Autre</option>
            </select>
          </div>
        </div>

        <div>
          <label for="message" class="block text-xs font-semibold text-navy/70 mb-1.5">Message *</label>
          <textarea
            id="message"
            name="Message"
            rows="4"
            required
            class="w-full rounded-lg border border-navy/10 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-accent/50"
          ></textarea>
        </div>

        <button
          type="submit"
          id="contact-submit"
          class="w-full inline-flex items-center justify-center bg-accent hover:bg-accent-dark text-white font-semibold px-8 py-3.5 rounded-full transition-colors disabled:opacity-60"
        >
          Envoyer ma demande
        </button>

        <p id="contact-form-status" class="text-sm text-center" role="status"></p>
      </form>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const submitBtn = document.getElementById("contact-submit") as HTMLButtonElement | null;
  const status = document.getElementById("contact-form-status");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!submitBtn || !status) return;

    submitBtn.disabled = true;
    submitBtn.textContent = "Envoi en cours...";
    status.textContent = "";
    status.className = "text-sm text-center";

    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new FormData(form),
      });
      const result = await response.json();

      if (result.success) {
        status.textContent = "Merci ! Votre message a bien été envoyé, nous revenons vers vous rapidement.";
        status.className = "text-sm text-center text-green-600";
        form.reset();
      } else {
        throw new Error(result.message || "Échec de l'envoi");
      }
    } catch {
      status.textContent = "L'envoi a échoué. Contactez-nous directement par WhatsApp en attendant.";
      status.className = "text-sm text-center text-red-600";
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Envoyer ma demande";
    }
  });
</script>
