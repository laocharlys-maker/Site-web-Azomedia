---
import Icon from "./Icon.astro";
import type { Service } from "../data/site";

interface Props extends Service {
  featured?: boolean;
}

const { icon, title, description, featured = false } = Astro.props;
---

<div
  class:list={[
    "reveal rounded-2xl p-6 border transition-shadow hover:shadow-xl",
    featured
      ? "bg-navy-gradient text-white border-transparent shadow-lg shadow-navy/20"
      : "bg-white border-navy/5 shadow-sm",
  ]}
>
  <div
    class:list={[
      "w-12 h-12 rounded-xl flex items-center justify-center mb-4",
      featured ? "bg-white/15 text-accent" : "bg-accent/10 text-accent",
    ]}
  >
    <Icon name={icon} class="w-6 h-6" />
  </div>
  <h3 class:list={["font-heading text-lg font-semibold mb-2", featured ? "text-white" : "text-navy"]}>
    {title}
  </h3>
  <p class:list={["text-sm leading-relaxed", featured ? "text-white/80" : "text-navy/70"]}>
    {description}
  </p>
</div>
