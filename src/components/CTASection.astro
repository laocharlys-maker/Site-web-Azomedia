---
import { site } from "../data/site";

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Prêt à faire entrer votre entreprise dans l'ère du numérique intelligent ?",
  subtitle = "Un diagnostic gratuit, sans engagement, pour identifier vos priorités.",
} = Astro.props;
---

<section class="reveal bg-navy-gradient text-white">
  <div class="max-w-5xl mx-auto px-6 lg:px-8 py-20 text-center">
    <h2 class="font-heading text-3xl md:text-4xl font-bold mb-4">{title}</h2>
    <p class="text-white/80 max-w-2xl mx-auto mb-10">{subtitle}</p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="#contact"
        class="inline-flex items-center justify-center bg-accent hover:bg-accent-dark text-white font-semibold px-8 py-3.5 rounded-full transition-colors"
      >
        Demander mon audit gratuit
      </a>
      <a
        href={site.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center bg-white/10 hover:bg-white/20 text-white font-semibold px-8 py-3.5 rounded-full border border-white/20 transition-colors"
      >
        Discuter sur WhatsApp
      </a>
    </div>
  </div>
</section>
