---
import { site } from "../data/site";
import Icon from "./Icon.astro";
---

<a
  href={site.whatsapp}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Nous écrire sur WhatsApp"
  class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-[#25D366] text-white flex items-center justify-center shadow-lg shadow-black/20 hover:scale-105 transition-transform"
>
  <Icon name="whatsapp" class="w-7 h-7" />
</a>
