---
import { site, sectors } from "../data/site";
---

<div id="audit-modal" class="audit-modal" aria-hidden="true">
  <div class="audit-modal__backdrop" data-audit-close></div>

  <div class="audit-modal__panel" role="dialog" aria-modal="true" aria-labelledby="audit-modal-title">
    <button type="button" class="audit-modal__close" data-audit-close aria-label="Fermer">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
      </svg>
    </button>

    <p class="text-accent font-semibold text-sm uppercase tracking-widest mb-2">Audit gratuit</p>
    <h2 id="audit-modal-title" class="font-heading text-2xl font-bold text-navy mb-2">Parlons de votre projet</h2>
    <p class="text-sm text-navy/60 mb-6">
      Remplissez ce formulaire, notre équipe revient vers vous rapidement pour caler votre audit gratuit.
    </p>

    <form id="audit-form" class="space-y-4">
      <input type="hidden" name="access_key" value={site.web3formsAccessKey} />
      <input type="hidden" name="subject" value="Nouvelle demande d'audit gratuit — AzoMedIA" />
      <input type="hidden" name="from_name" value="Formulaire Audit — site AzoMedIA" />

      <div>
        <label for="audit-name" class="block text-xs font-semibold text-navy/70 mb-1.5">Nom et prénom *</label>
        <input
          id="audit-name"
          name="Nom et prénom"
          type="text"
          required
          class="w-full rounded-lg border border-navy/10 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-accent/50"
        />
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label for="audit-phone" class="block text-xs font-semibold text-navy/70 mb-1.5">Contact *</label>
          <input
            id="audit-phone"
            name="Contact"
            type="tel"
            required
            class="w-full rounded-lg border border-navy/10 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-accent/50"
          />
        </div>
        <div>
          <label for="audit-email" class="block text-xs font-semibold text-navy/70 mb-1.5">Adresse email *</label>
          <input
            id="audit-email"
            name="Adresse email"
            type="email"
            required
            class="w-full rounded-lg border border-navy/10 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-accent/50"
          />
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label for="audit-company" class="block text-xs font-semibold text-navy/70 mb-1.5">Nom de l'entreprise</label>
          <input
            id="audit-company"
            name="Entreprise"
            type="text"
            class="w-full rounded-lg border border-navy/10 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-accent/50"
          />
        </div>
        <div>
          <label for="audit-sector" class="block text-xs font-semibold text-navy/70 mb-1.5">Secteur d'activité</label>
          <select
            id="audit-sector"
            name="Secteur"
            class="w-full rounded-lg border border-navy/10 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-accent/50"
          >
            <option value="">Sélectionner...</option>
            {sectors.map((sector) => <option value={sector}>{sector}</option>)}
            <option value="Autre">Autre</option>
          </select>
        </div>
      </div>

      <div>
        <label for="audit-need" class="block text-xs font-semibold text-navy/70 mb-1.5">Votre besoin *</label>
        <textarea
          id="audit-need"
          name="Besoin"
          rows="4"
          required
          class="w-full rounded-lg border border-navy/10 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-accent/50"
        ></textarea>
      </div>

      <button
        type="submit"
        id="audit-submit"
        class="w-full inline-flex items-center justify-center bg-accent hover:bg-accent-dark text-white font-semibold px-8 py-3.5 rounded-full transition-colors disabled:opacity-60"
      >
        Envoyer ma demande d'audit
      </button>

      <p id="audit-form-status" class="text-sm text-center" role="status"></p>
    </form>
  </div>
</div>

<style>
  .audit-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: none;
  }

  .audit-modal.is-open {
    display: block;
  }

  .audit-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 42, 74, 0.6);
    backdrop-filter: blur(4px);
  }

  .audit-modal__panel {
    position: relative;
    max-width: 40rem;
    margin: 4vh auto;
    max-height: 92vh;
    overflow-y: auto;
    background: white;
    border-radius: 1.25rem;
    padding: 2rem;
    box-shadow: 0 25px 60px rgba(15, 42, 74, 0.35);
  }

  .audit-modal__close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    color: rgb(15 42 74 / 0.5);
  }

  .audit-modal__close:hover {
    color: rgb(15 42 74);
  }
</style>

<script>
  const modal = document.getElementById("audit-modal");
  const form = document.getElementById("audit-form") as HTMLFormElement | null;
  const submitBtn = document.getElementById("audit-submit") as HTMLButtonElement | null;
  const status = document.getElementById("audit-form-status");

  function openModal() {
    modal?.classList.add("is-open");
    modal?.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    (document.getElementById("audit-name") as HTMLInputElement | null)?.focus();
  }

  function closeModal() {
    modal?.classList.remove("is-open");
    modal?.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.closest("[data-open-audit]")) {
      e.preventDefault();
      openModal();
    }
    if (target.closest("[data-audit-close]")) {
      closeModal();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal?.classList.contains("is-open")) {
      closeModal();
    }
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!submitBtn || !status) return;

    submitBtn.disabled = true;
    submitBtn.textContent = "Envoi en cours...";
    status.textContent = "";
    status.className = "text-sm text-center";

    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new FormData(form),
      });
      const result = await response.json();

      if (result.success) {
        status.textContent = "Merci ! Votre demande a bien été envoyée, nous revenons vers vous rapidement.";
        status.className = "text-sm text-center text-green-600";
        form.reset();
      } else {
        throw new Error(result.message || "Échec de l'envoi");
      }
    } catch {
      status.textContent = "L'envoi a échoué. Contactez-nous directement par WhatsApp en attendant.";
      status.className = "text-sm text-center text-red-600";
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Envoyer ma demande d'audit";
    }
  });
</script>
