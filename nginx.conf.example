# Exemple de configuration Nginx pour servir le site statique AzoMedIA (dossier dist/)
# sur un VPS Ubuntu 22.04. À adapter (domaine, chemin) puis copier vers
# /etc/nginx/sites-available/azomedia et activer avec un lien symbolique vers sites-enabled.

server {
    listen 80;
    listen [::]:80;
    server_name digital.azomedia.site; # remplacer par azomedia.site après migration

    root /var/www/azomedia/dist;
    index index.html;

    # Astro génère des routes en dossiers (ex: /blog/mon-article/index.html)
    location / {
        try_files $uri $uri/ $uri/index.html =404;
    }

    # Cache long sur les assets buildés (fingerprintés par Astro/Vite)
    location /_astro/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /404.html {
        internal;
    }

    error_page 404 /404.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
}

# Une fois prêt pour HTTPS (recommandé) : lancer `sudo certbot --nginx -d digital.azomedia.site`
# (paquet certbot + python3-certbot-nginx), qui réécrit ce fichier pour ajouter le bloc 443/SSL.
